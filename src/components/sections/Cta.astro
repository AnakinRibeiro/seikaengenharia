---
import { Image } from 'astro:assets';
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import ctaImage from '../../assets/cta-usina-solar.jpg';
import { simulationCtaLink } from '../../lib/site';
import styles from './Cta.module.css';
---

<section class={styles.section} id="contato">
  <div class={styles.backdrop} aria-hidden="true">
    <Image
      src={ctaImage}
      alt=""
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>

  <Container class={styles.container} data-reveal-children>
    <h2 class={styles.title}>
      Comece pelo mais simples: <br class={styles.desktopBreak} aria-hidden="true" />mande
      sua conta de luz
    </h2>

    <p class={styles.paragraph}>
      Uma foto da fatura pelo WhatsApp já é suficiente para sabermos quanto <br class={styles.desktopBreak} aria-hidden="true" />você
      pode economizar. Sem compromisso, sem custo.
    </p>

    <Button {...simulationCtaLink} size="large" class={styles.cta}>
      Simular minha economia
    </Button>
  </Container>
</section>
