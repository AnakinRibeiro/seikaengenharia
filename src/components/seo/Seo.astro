---
import { site } from '../../lib/site';
import logoAsset from '../../assets/logo-seika.png';

interface Props {
  title: string;
  description?: string;
  /** Path or absolute URL of the social preview image. */
  image?: string;
  imageAlt?: string;
  /** `article` for blog/case-study pages. */
  type?: 'website' | 'article';
  /** Keep this page out of search results. */
  noindex?: boolean;
  /** Extra JSON-LD blocks for the page (FAQPage, Service, BreadcrumbList…). */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  imageAlt = site.ogImageAlt,
  type = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

/*
 * One origin for every absolute URL on the page — canonical, Open Graph and
 * JSON-LD alike. `Astro.site` (astro.config.mjs) wins; `site.url` is only the
 * fallback. Mixing the two is how canonical and schema ended up on different
 * hosts (with and without www).
 */
const base = Astro.site ?? new URL(site.url);
const homeUrl = new URL('/', base).href;

const canonical = new URL(Astro.url.pathname, base);
const imageUrl = new URL(image, base);
/** Only the default OG image has known dimensions. */
const isDefaultImage = image === site.ogImage;

/** Home page passes its full title; inner pages get the brand suffix. */
const fullTitle =
  Astro.url.pathname === '/' ? title : `${title} | ${site.name}`;

const socialUrls = Object.values(site.social).filter(Boolean);

/** Drop empty address fields instead of publishing them as "". */
const address = Object.fromEntries(
  Object.entries(site.address).filter(([, value]) => value)
);

const organization = {
  /*
   * Electrician is a LocalBusiness subtype (via HomeAndConstructionBusiness),
   * so it inherits everything LocalBusiness meant and says more about the
   * trade. Organization is implied by both.
   */
  '@type': 'Electrician',
  '@id': `${homeUrl}#organization`,
  name: site.name,
  ...(site.legalName && { legalName: site.legalName }),
  url: homeUrl,
  description: site.description,
  image: imageUrl.href,
  // Imported, so the URL always points at a file the build actually emitted.
  logo: new URL(logoAsset.src, base).href,
  ...(site.contact.phone && { telephone: site.contact.phone }),
  ...(site.contact.email && { email: site.contact.email }),
  ...(site.taxId && { taxID: site.taxId }),
  ...(Object.keys(address).length > 0 && {
    address: { '@type': 'PostalAddress', ...address },
  }),
  ...(site.areaServed.length > 0 && { areaServed: site.areaServed }),
  ...(socialUrls.length > 0 && { sameAs: socialUrls }),
};

const website = {
  '@type': 'WebSite',
  '@id': `${homeUrl}#website`,
  url: homeUrl,
  name: site.name,
  inLanguage: site.locale,
  publisher: { '@id': `${homeUrl}#organization` },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...schema],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />

{noindex && <meta name="robots" content="noindex, nofollow" />}
{
  !noindex && (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

{/* Open Graph */}
<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={imageUrl.href} />
{
  isDefaultImage && (
    <>
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content={String(site.ogImageWidth)} />
      <meta property="og:image:height" content={String(site.ogImageHeight)} />
    </>
  )
}
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={site.localeOg} />

{/* Twitter / X */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />
<meta name="twitter:image:alt" content={imageAlt} />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
/>
