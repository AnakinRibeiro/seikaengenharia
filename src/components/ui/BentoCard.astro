---
import Icon from '../icons/Icon.astro';
import type { IconName } from '../icons/icons';
import styles from './BentoCard.module.css';

interface Props {
  icon: IconName;
  title: string;
  /** Optional — the Figma component can hide the description. */
  description?: string;
  /** Heading level, so the card fits the page's outline. */
  as?: 'h2' | 'h3' | 'h4' | 'p';
  class?: string;
}

const {
  icon,
  title,
  description,
  as: Title = 'h3',
  class: className,
}: Props = Astro.props;
---

<article class:list={[styles.card, className]}>
  <span class={styles.iconContainer}>
    <Icon name={icon} size={22} />
  </span>
  <Title class={styles.title}>{title}</Title>
  {description && <p class={styles.description}>{description}</p>}
</article>
