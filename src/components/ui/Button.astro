---
import type { HTMLAttributes } from 'astro/types';
import styles from './Button.module.css';
import typography from '../../styles/typography.module.css';

export type ButtonModel = 'primary' | 'secondary';

type Props = {
  model?: ButtonModel;
  /** Renders an <a> instead of a <button>. */
  href?: string;
  fullWidth?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'button'>, 'class'> &
  Omit<HTMLAttributes<'a'>, 'class'>;

const {
  model = 'primary',
  href,
  fullWidth = false,
  class: className,
  type,
  ...rest
} = Astro.props;

/*
 * One size in the component set — Primary and Secondary differ in fill and
 * border only, and both use body/large.
 */
const classList = [
  styles.button,
  styles[model],
  typography.bodyLarge,
  fullWidth && styles.fullWidth,
  className,
]
  .filter(Boolean)
  .join(' ');

const Tag = href ? 'a' : 'button';
---

<Tag
  class={classList}
  href={href}
  type={href ? undefined : (type ?? 'button')}
  {...rest}
>
  <slot />
</Tag>
