---
import type { HTMLAttributes } from 'astro/types';
import styles from './Button.module.css';
import typography from '../../styles/typography.module.css';

export type ButtonModel = 'primary' | 'secondary';
export type ButtonSize = 'large' | 'small';

type Props = {
  model?: ButtonModel;
  size?: ButtonSize;
  /** Renders an <a> instead of a <button>. */
  href?: string;
  fullWidth?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'button'>, 'class'> &
  Omit<HTMLAttributes<'a'>, 'class'>;

const {
  model = 'primary',
  size = 'large',
  href,
  fullWidth = false,
  class: className,
  type,
  ...rest
} = Astro.props;

/*
 * Size=Large is body/large (18/150% SemiBold) in the Figma button component —
 * verified against the Hero, which is the only frame migrated so far.
 *
 * Size=Small is NOT yet verified against the new library; it keeps the old
 * `buttonTextSmall` alias until a frame that uses it is migrated. The quirk it
 * encodes — Small + Secondary borrowing the larger text style — came from the
 * previous library and should be re-checked at the same time.
 */
const usesLargeText = size === 'large' || model === 'secondary';

const classList = [
  styles.button,
  styles[model],
  styles[size],
  usesLargeText ? typography.bodyLarge : typography.buttonTextSmall,
  fullWidth && styles.fullWidth,
  className,
]
  .filter(Boolean)
  .join(' ');

const Tag = href ? 'a' : 'button';
---

<Tag
  class={classList}
  href={href}
  type={href ? undefined : (type ?? 'button')}
  {...rest}
>
  <slot />
</Tag>
