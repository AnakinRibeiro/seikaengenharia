---
import Icon from '../icons/Icon.astro';
import styles from './Rating.module.css';

export type RatingValue = 1 | 2 | 3 | 4 | 5;

interface Props {
  rating: RatingValue;
  /**
   * Figma's Rating variants draw only the earned stars (Rating=3 is 50px wide,
   * three stars and nothing else), so this is off by default. Turn it on to pad
   * the row to five stars when ratings need to line up in a column.
   */
  showEmpty?: boolean;
  class?: string;
}

const { rating, showEmpty = false, class: className } = Astro.props;

const total = showEmpty ? 5 : rating;
const stars = Array.from({ length: total }, (_, i) => i < rating);
---

<span
  class:list={[styles.rating, className]}
  role="img"
  aria-label={`${rating} de 5 estrelas`}
>
  {
    stars.map((filled) => (
      <Icon name="star" size={14} class={filled ? undefined : styles.empty} />
    ))
  }
</span>
