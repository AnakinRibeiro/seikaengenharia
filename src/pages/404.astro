---
/*
 * Served by the host for any URL that does not exist (Netlify, Vercel,
 * Cloudflare Pages and GitHub Pages all pick up dist/404.html). Without it
 * a mistyped or outdated link lands on the host's generic error page — no
 * header, no way back. noindex keeps it out of search results; the sitemap
 * integration already skips it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import Footer from '../components/sections/Footer.astro';
import typography from '../styles/typography.module.css';
---

<BaseLayout title="Página não encontrada" noindex>
  <Container class="notFound">
    <p class={typography.bodySmallUppercase}>Erro 404</p>
    <h1 class={typography.headingH3}>Página não encontrada</h1>
    <p class={typography.bodyBody}>
      O endereço pode ter mudado ou não existir mais. Volte para a página
      inicial ou fale com a nossa equipe pelo WhatsApp.
    </p>
    <div class="actions">
      <Button href="/">Ir para a página inicial</Button>
    </div>
  </Container>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .notFound {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: calc(var(--header-height) + var(--space-14)) var(--space-14);
    color: var(--color-text-primary);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }

  @media (max-width: 767px) {
    .notFound {
      padding-block-start: calc(var(--header-height-mobile) + var(--space-10));
    }
  }
</style>
